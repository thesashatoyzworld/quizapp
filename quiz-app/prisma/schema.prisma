generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════
// ПОЛЬЗОВАТЕЛИ
// ═══════════════════════════════════════

model User {
  id           String   @id @default(uuid())
  telegramId   BigInt   @unique @map("telegram_id")
  username     String?
  firstName    String?  @map("first_name")
  quizResult   String?  @map("quiz_result")
  createdAt    DateTime @default(now()) @map("created_at")

  purchases    Purchase[]
  events       Event[]
  accesses     ProductAccess[]

  @@map("users")
}

// ═══════════════════════════════════════
// ПРОДУКТЫ И ДОСТУП
// ═══════════════════════════════════════

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  price       Int
  type        String   @default("one_time")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  materials   Material[]
  purchases   Purchase[]

  @@map("products")
}

model Purchase {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id])
  amount          Int
  source          String?
  utmSource       String?  @map("utm_source")
  utmMedium       String?  @map("utm_medium")
  utmCampaign     String?  @map("utm_campaign")
  prodamusOrderId String?  @map("prodamus_order_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("purchases")
}

model Material {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])
  title       String
  description String?
  type        String
  url         String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("materials")
}

// ═══════════════════════════════════════
// ДОСТУПЫ (единая модель: разовые + подписки)
// ═══════════════════════════════════════
//
// Один доступ = право человека на один продукт.
//   expiresAt = null  → бессрочно (разовый, напр. МК)
//   expiresAt = дата  → подписка: открыто до даты; продление сдвигает дату,
//                       просрочку закрывает крон (status → expired).
// Доступ может существовать без User (оплата картой с сайта без Telegram):
// тогда userId = null, привязка по telegramId позже или по контакту.

model ProductAccess {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  user        User?     @relation(fields: [userId], references: [id])
  telegramId  BigInt?   @map("telegram_id")
  productSlug String    @map("product_slug")
  role        String
  grantedAt   DateTime  @default(now()) @map("granted_at")
  expiresAt   DateTime? @map("expires_at")
  status      String    @default("active") // active | expired | revoked
  source      String?   // prodamus order_id / subscription id
  period      String?   // week | month | null (разовый)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([telegramId])
  @@index([productSlug])
  @@index([status])
  @@map("product_access")
}

// ═══════════════════════════════════════
// СОБЫТИЯ (АНАЛИТИКА)
// ═══════════════════════════════════════

model Event {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])
  telegramId  BigInt?  @map("telegram_id")
  type        String
  source      String   @default("thesasha")
  funnel      String?
  productSlug String?  @map("product_slug")
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([source])
  @@index([telegramId])
  @@index([createdAt])
  @@map("events")
}

// ═══════════════════════════════════════
// ФОЛЛОУ-АП ОЧЕРЕДЬ
// ═══════════════════════════════════════

model FollowUp {
  id           String    @id @default(uuid())
  telegramId   BigInt    @map("telegram_id")
  username     String?
  resultId     String?   @map("result_id")
  messagesSent Int       @default(0) @map("messages_sent")
  lastSentAt   DateTime? @map("last_sent_at")
  paid         Boolean   @default(false)
  registeredAt DateTime  @default(now()) @map("registered_at")

  @@unique([telegramId])
  @@map("follow_ups")
}

// ═══════════════════════════════════════
// SYNC ВЕЙТЛИСТ
// ═══════════════════════════════════════

model SyncWaitlist {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @map("telegram_id")
  username   String?
  firstName  String?  @map("first_name")
  tier       String   // easy, mid, hard
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([telegramId, tier])
  @@index([tier])
  @@map("sync_waitlist")
}

// ═══════════════════════════════════════
// INSTAGRAM АВТООТВЕТЫ
// ═══════════════════════════════════════

model IgKeyword {
  id          Int      @id @default(autoincrement())
  keyword     String   @unique // ключевое слово (регистронезависимо)
  replyText   String   @map("reply_text") // текст private reply
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  replies     IgReply[]

  @@map("ig_keywords")
}

model IgReply {
  id              Int      @id @default(autoincrement())
  keywordId       Int      @map("keyword_id")
  keyword         IgKeyword @relation(fields: [keywordId], references: [id])
  commentId       String   @unique @map("comment_id") // для дедупликации
  igUserId        String   @map("ig_user_id")
  igUsername       String?  @map("ig_username")
  mediaId         String?  @map("media_id")
  commentText     String?  @map("comment_text")
  replySent       Boolean  @default(false) @map("reply_sent")
  error           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([igUserId])
  @@index([createdAt])
  @@map("ig_replies")
}

model IgWebhookLog {
  id        Int      @id @default(autoincrement())
  payload   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ig_webhook_logs")
}

// ═══════════════════════════════════════
// СПРИНТ ВЕЙТЛИСТ
// ═══════════════════════════════════════

model SprintWaitlist {
  id           Int      @id @default(autoincrement())
  telegramId   String?  @map("telegram_id")
  name         String
  telegram     String
  occupation   String
  hasSite      String   @map("has_site")
  needs        String[]
  aiExperience String   @map("ai_experience")
  source       String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sprint_waitlist")
}

// ═══════════════════════════════════════
// МАСТЕРКЛАСС SYNC ВЕЙТЛИСТ
// ═══════════════════════════════════════

model MasterclassSyncWaitlist {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique @map("telegram_id")
  username   String?
  firstName  String?  @map("first_name")
  lastName   String?  @map("last_name")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("masterclass_sync_waitlist")
}

// ═══════════════════════════════════════
// МК «РАЗРЕШЕНИЕ БЫСТРЫХ ДЕНЕГ» ВЕЙТЛИСТ
// ═══════════════════════════════════════

model MoneyMkWaitlist {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique @map("telegram_id")
  username   String?
  firstName  String?  @map("first_name")
  lastName   String?  @map("last_name")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("money_mk_waitlist")
}

// ═══════════════════════════════════════
// СТАТУСЫ ЛИДОВ (лидборд в админке)
// ═══════════════════════════════════════
//
// Ручной статус лида по конкретному продукту. Сами лиды берутся живьём из
// events (клики «Забрать» / заходы на лендинг), а здесь ассистент/оператор
// ведёт, что с человеком делали: написали, ответил, купил, слился.
// Ключ — (product, telegramId): один человек может быть лидом разных продуктов.

model LeadStatus {
  id         String   @id @default(uuid())
  product    String   @default("uroven") // uroven | mk-dengi | ...
  telegramId BigInt   @map("telegram_id")
  status     String   @default("new")    // new | written | replied | bought | rejected
  note       String?
  updatedBy  String?  @map("updated_by")  // username оператора, кто последним менял
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([product, telegramId])
  @@index([product])
  @@map("lead_status")
}

// ═══════════════════════════════════════
// DWY — АНКЕТА НА ГРУППУ «ДЕЛАЕМ ВМЕСТЕ»
// ═══════════════════════════════════════

model DwyLead {
  id         Int      @id @default(autoincrement())
  telegramId String?  @map("telegram_id")
  username   String?
  firstName  String?  @map("first_name")
  // Всё, кроме имени и контакта, необязательно: у листа ожидания обязательны
  // только они. Что именно требовать в каждом потоке — решает DWY_MODES,
  // а не база.
  who        String?
  hasProduct String?  @map("has_product")
  product    String?
  level      Int?
  tried      String?
  want       String?
  income     String?
  hours      String?
  contact    String?
  phone      String?
  instagram  String?
  // mentor — менторство, t2/t3 — лист ожидания тарифа «Нового уровня контента».
  // Анкета одна на оба потока, отличаем по этой колонке.
  kind       String?
  source     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("dwy_leads")
}

// ═══════════════════════════════════════
// INTAKE — АНКЕТА ТАРИФА 3 ДО ПЕРВОГО СОЗВОНА
// ═══════════════════════════════════════
// Бот собирает досье в личке (11 вопросов, ответы голосом или текстом),
// чтобы созвон 1-1 начинался с работы, а не со сбора вводных.
// Одна анкета на человека: повторный /anketa продолжает её, а не создаёт вторую.

model Intake {
  id          String    @id @default(uuid())
  // Пусто, пока человек не перешёл по персональной ссылке: тех, кто ни разу
  // не заходил в бота, мы по telegram_id не знаем. Проставляется при переходе.
  telegramId  BigInt?   @unique @map("telegram_id")
  username    String?
  firstName   String?   @map("first_name")
  /** как Саша назвал человека, когда выдавал ссылку вслепую */
  label       String?
  status      String    @default("invited") // invited | in_progress | done
  /** какой набор вопросов: t2 — маршрут по материалам, t3 — досье к созвону 1-1 */
  track       String    @default("t3")
  currentStep Int       @default(0) @map("current_step")
  /**
   * Личная анкета: вопросы, написанные под конкретного человека после созвона.
   * Формат {"preamble"?: string, "questions": [{"title","body"}]}. Пусто = вопросы трека.
   */
  customQuestions Json?  @map("custom_questions")
  inviteToken String?   @unique @map("invite_token") // персональная ссылка для тех, кто не в боте
  invitedAt   DateTime  @default(now()) @map("invited_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  remindedAt  DateTime? @map("reminded_at") // напоминание ровно одно
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  answers IntakeAnswer[]

  @@index([status])
  @@map("intakes")
}

model IntakeAnswer {
  id       String @id @default(uuid())
  intakeId String @map("intake_id")
  intake   Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  // индекс вопроса 0..10; -1 = добивающий вопрос Саши после сбора анкеты
  step          Int
  extraQuestion String? @map("extra_question")

  kind        String // text | voice | photo | document | video_note
  rawText     String? @map("raw_text")
  transcript  String? // расшифровка голосового через whisper
  fileId      String? @map("file_id") // telegram file_id, чтобы Саша послушал сам
  durationSec Int?    @map("duration_sec")
  skipped     Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([intakeId, step])
  @@map("intake_answers")
}

// ═══════════════════════════════════════
// МАРШРУТНЫЕ КАРТЫ КЛИЕНТОВ
// ═══════════════════════════════════════
// Где клиент менторства находится, куда идёт и что мешает. Саша правит карту
// через /admin/roadmaps, клиент смотрит свою в кабинете (/karta) — но только
// если карта помечена clientVisible, и только те строки, у которых
// visibility = shared. Всё остальное (диагнозы, риски, задачи Саши) internal.
//
// ⚠ Таблицы заводятся скриптом scripts/roadmap-create-tables.mjs.
// `prisma db push` на этой базе запрещён — она общая с другими приложениями.

model Roadmap {
  id          String  @id @default(uuid())
  slug        String  @unique // папка клиента в GSD-BRAND: azamat-gimaev
  clientName  String  @map("client_name")
  telegramId  BigInt? @map("telegram_id")
  username    String?
  tier        String? // uroven-t3, uroven-t2

  /** сколько занёс и сколько из этого уже отбил своими продажами */
  paidAmount Int? @map("paid_amount")
  returned   Int  @default(0)

  startedAt   DateTime? @map("started_at")
  accessUntil DateTime? @map("access_until")

  /** куда идём вообще и цель текущего периода */
  goal       String?
  periodGoal String? @map("period_goal")

  /** карта открыта клиенту в кабинете (/karta). Внутри он видит только строки с visibility=shared */
  clientVisible Boolean @default(false) @map("client_visible")
  /** строка сверху клиентского вида: зачем эта карта и как ей пользоваться */
  clientIntro   String? @map("client_intro")

  archived    Boolean   @default(false)
  lastTouchAt DateTime? @map("last_touch_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  metrics RoadmapMetric[]
  steps   RoadmapStep[]
  tasks   RoadmapTask[]
  notes   RoadmapNote[]

  @@map("roadmaps")
}

model RoadmapMetric {
  id        String  @id @default(uuid())
  roadmapId String  @map("roadmap_id")
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  key          String // leads, calls, sales, revenue
  label        String
  startValue   String? @map("start_value")
  currentValue String? @map("current_value")
  unit         String?
  position     Int     @default(0)
  visibility   String  @default("internal")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([roadmapId, key])
  @@map("roadmap_metrics")
}

model RoadmapStep {
  id        String  @id @default(uuid())
  roadmapId String  @map("roadmap_id")
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  position Int
  title    String
  status   String  @default("todo") // done | partial | blocked | todo
  /** чем подтверждается: дата, цифра, ссылка */
  evidence String?

  visibility String   @default("internal")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([roadmapId, position])
  @@map("roadmap_steps")
}

model RoadmapTask {
  id        String  @id @default(uuid())
  roadmapId String  @map("roadmap_id")
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  /** устойчивый ключ из roadmap.json: переписанное название не плодит вторую задачу */
  key      String?
  position Int     @default(0)
  title    String
  /** зачем эта задача: аргумент, который проговариваем на созвоне */
  why      String?
  owner    String  @default("client") // client | sasha
  status   String  @default("todo") // todo | doing | done | dropped
  dueOn    DateTime? @db.Date @map("due_on")
  doneAt   DateTime? @map("done_at")

  /** материал к задаче: воркшоп, разбор, запись созвона — чтобы не искать самому */
  linkUrl   String? @map("link_url")
  linkLabel String? @map("link_label")

  visibility String   @default("internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([roadmapId, status])
  @@map("roadmap_tasks")
}

model RoadmapNote {
  id        String  @id @default(uuid())
  roadmapId String  @map("roadmap_id")
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  kind       String    @default("insight") // blocker | risk | decision | insight | touch
  body       String
  /** откуда: созвон 10.08, группа, личка, разбор */
  source     String?
  happenedOn DateTime? @db.Date @map("happened_on")

  visibility String   @default("internal")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([roadmapId, kind])
  @@map("roadmap_notes")
}

// ═══════════════════════════════════════
// INSTAGRAM — ЛЮДИ ИЗ ВОРОНОК CHATPLACE
// ═══════════════════════════════════════
//
// Кто зашёл в автоматизацию @thesashatoyz (кодовое слово в директ или коммент).
// Сами люди живут в ChatPlace, у нас — их слепок плюс то, чего ChatPlace не
// хранит: ручной статус и заметка ассистента. Ключ — (clientId, automationId):
// один человек может пройти несколько воронок, и по каждой у него свой статус.
// Слепок обновляет синхронизация, статус и заметку она не трогает.

model IgLead {
  id       String @id @default(uuid())
  clientId String @map("client_id") // id клиента в ChatPlace
  username String?
  name     String?

  automationId   String  @map("automation_id")
  automationName String? @map("automation_name")
  keyword        String? // кодовое слово, по которому человек вошёл

  firstSeenAt DateTime @map("first_seen_at")
  lastEventAt DateTime @map("last_event_at")

  chatId      String? @map("chat_id")
  chatStatus  String? @map("chat_status")  // active | stopped | unsubscribe
  chatHandler String? @map("chat_handler") // open (ведёт оператор) | closed (ведёт бот)

  status    String  @default("new") // new | written | replied | bought | rejected
  note      String?
  updatedBy String? @map("updated_by")

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, automationId])
  @@index([automationId])
  @@index([status])
  @@map("ig_lead")
}
