# === Database (required) ===
# Supabase pooler connection (port 6543, ?pgbouncer=true)
DATABASE_URL=
# Supabase direct connection (port 5432, for migrations)
DIRECT_URL=

# === Telegram (required) ===
BOT_TOKEN=
ADMIN_CHAT_ID=
# Рабочий аккаунт @sashatoyzwork: туда дублируются только заявки и деньги
# (анкеты, DWY-лиды, оплаты, выдача доступа). Пусто = дублирования нет.
ADMIN_CHAT_ID_WORK=
# Секрет вебхука: тот же, что передан в setWebhook (node scripts/set-webhook.mjs).
# Пока пусто — роут принимает любой POST.
TELEGRAM_WEBHOOK_SECRET=

# === App ===
NEXT_PUBLIC_WEBAPP_URL=https://your-app.vercel.app

# === Payments ===
PRODAMUS_SECRET_KEY=
NEXT_PUBLIC_PRODAMUS_FORM_URL=

# === Notion ===
NOTION_API_KEY=
NOTION_EVENTS_DB_ID=
NOTION_FOLLOWUP_DB_ID=

# === QStash ===
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# === Cron ===
CRON_SECRET=

# === Admin ===
ADMIN_PASSWORD=
